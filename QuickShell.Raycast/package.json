{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "quickshell",
  "title": "QuickShell",
  "description": "Keyboard-first workspace launcher for developers",
  "icon": "extension-icon.png",
  "author": "tonythethompson",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "open-workspace",
      "title": "Open Workspace",
      "description": "Search and open saved workspaces",
      "mode": "view"
    },
    {
      "name": "create-workspace",
      "title": "Create Workspace",
      "description": "Create a new workspace",
      "mode": "view"
    },
    {
      "name": "edit-workspace",
      "title": "Edit Workspace",
      "description": "Edit an existing workspace",
      "mode": "view"
    },
    {
      "name": "settings",
      "title": "Settings",
      "description": "Configure QuickShell defaults",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.103.6",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
